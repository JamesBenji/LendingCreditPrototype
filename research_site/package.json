{
  "name": "lending-credit-research-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "extract": "node scripts/extract.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/validate.mjs && prettier --check .",
    "format": "prettier --write .",
    "build": "node scripts/extract.mjs --check && node scripts/validate.mjs && astro build && pagefind --site dist && node scripts/check-built.mjs",
    "preview": "astro preview",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "astro": "5.16.0",
    "katex": "0.16.25",
    "markdown-it": "14.1.0",
    "markdown-it-anchor": "9.2.0",
    "markdown-it-texmath": "1.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "cheerio": "1.1.2",
    "pagefind": "1.4.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1"
  }
}
